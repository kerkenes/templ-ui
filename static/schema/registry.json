{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://templ-ui.muratkirazkaya.com/schema/registry.json",
  "title": "templ-ui registry.json",
  "description": "A templ-ui registry of components, examples and libraries.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "The name of the registry."
    },
    "homepage": {
      "type": "string",
      "description": "The homepage of the registry."
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "https://templ-ui.muratkirazkaya.com/schema/registry-item.json"
      }
    }
  },
  "required": ["name", "homepage", "items"]
}
