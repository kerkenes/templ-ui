package showcase

import "github.com/kerkenes/templ-ui/components/segmentedprocess"

templ SegmentedProcessHeight() {
	<div class="w-full max-w-md">
		@segmentedprocess.SegmentedProcess(segmentedprocess.Props{
			Max:    100,
			Height: 24,
			Segments: []segmentedprocess.Segment{
				{Label: "Segment A", Value: 45},
				{Label: "Segment B", Value: 30},
				{Label: "Segment C", Value: 15},
			},
		})
	</div>
}
