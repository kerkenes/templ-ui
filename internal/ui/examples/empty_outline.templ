package examples

import (
	"github.com/kerkenes/templ-ui/components/button"
	"github.com/kerkenes/templ-ui/components/empty"
	"github.com/kerkenes/templ-ui/components/icon"
)

templ EmptyOutline() {
	@empty.Empty(empty.Props{Class: "border border-dashed"}) {
		@empty.Header() {
			@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
				@icon.Cloud()
			}
			@empty.Title() {
				Cloud Storage Empty
			}
			@empty.Description() {
				Upload files to your cloud storage to access them anywhere.
			}
		}
		@empty.Content() {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
			}) {
				Upload Files
			}
		}
	}
}
