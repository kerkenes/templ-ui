package examples

import (
	"github.com/kerkenes/templ-ui/components/label"
	switchcomp "github.com/kerkenes/templ-ui/components/switch"
)

templ SwitchDemo() {
	<div class="flex items-center space-x-2">
		@switchcomp.Switch(switchcomp.Props{ID: "airplane-mode"})
		@label.Label(label.Props{For: "airplane-mode"}) {
			Airplane Mode
		}
	</div>
}
