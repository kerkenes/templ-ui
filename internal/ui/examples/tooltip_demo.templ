package examples

import (
	"github.com/kerkenes/templ-ui/components/button"
	"github.com/kerkenes/templ-ui/components/tooltip"
)

templ TooltipDemo() {
	@tooltip.Tooltip() {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Attributes: tooltip.Trigger(ctx),
		}) {
			Hover
		}
		@tooltip.Content() {
			<p>Add to library</p>
		}
	}
}
