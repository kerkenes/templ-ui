package examples

import (
	"github.com/kerkenes/templ-ui/components/icon"
	"github.com/kerkenes/templ-ui/components/tabs"
)

templ TabsIcons() {
	@tabs.Tabs(tabs.Props{DefaultValue: "preview"}) {
		@tabs.List() {
			@tabs.Trigger(tabs.TriggerProps{Value: "preview"}) {
				@icon.AppWindow()
				Preview
			}
			@tabs.Trigger(tabs.TriggerProps{Value: "code"}) {
				@icon.Code()
				Code
			}
		}
	}
}
