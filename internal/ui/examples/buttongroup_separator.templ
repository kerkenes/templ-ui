package examples

import (
	"github.com/kerkenes/templ-ui/components/button"
	"github.com/kerkenes/templ-ui/components/buttongroup"
)

templ ButtonGroupSeparatorExample() {
	@buttongroup.ButtonGroup() {
		@button.Button(button.Props{
			Variant: button.VariantSecondary,
			Size:    button.SizeSm,
		}) {
			Copy
		}
		@buttongroup.Separator()
		@button.Button(button.Props{
			Variant: button.VariantSecondary,
			Size:    button.SizeSm,
		}) {
			Paste
		}
	}
}
