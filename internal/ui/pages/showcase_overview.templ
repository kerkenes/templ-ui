templ ShowcaseOverview() {
	@layouts.DocsLayout(
		"Showcase",
		"Every component's default preview, on one page.",
		[]modules.TableOfContentsItem{},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Showcase",
			Description: templ.Raw("Every component's default preview, on one page, sized to how much room each one actually needs."),
			HideSource:  true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{
						Text: "Docs",
						Path: "/docs",
					},
					{
						Text: "Showcase",
					},
				},
			},
		}) {
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				for _, item := range showcaseItems {
					@card.Card(card.Props{Class: item.spanClass()}) {
						@card.Header(card.HeaderProps{Class: "pb-6"}) {
							@card.Title() {
								{ item.Name }
							}
						}
						@card.Content(card.ContentProps{
							Class: "flex items-center justify-center overflow-hidden rounded-md border p-6 " + item.heightClass(),
						}) {
							if item.Note != "" {
								<p class="text-center text-sm text-muted-foreground">{ item.Note }</p>
							} else {
								@item.Preview
							}
						}
						@card.Footer(card.FooterProps{Class: "pt-6"}) {
							<a href={ templ.SafeURL(item.Href) } class="text-sm text-muted-foreground hover:text-foreground hover:underline">
								View docs
							</a>
						}
					}
				}
			</div>
		}
	}
}
