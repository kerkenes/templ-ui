package sidebar10

import "github.com/kerkenes/templ-ui/components/sidebar"

templ NavSecondary(items []NavItem, class string) {
	@sidebar.Group(sidebar.GroupProps{Class: class}) {
		@sidebar.GroupContent() {
			@sidebar.Menu() {
				for _, item := range items {
					@sidebar.MenuItem() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{Href: item.URL}) {
							@item.Icon()
							<span>{ item.Title }</span>
						}
						if item.Badge != "" {
							@sidebar.MenuBadge() {
								{ item.Badge }
							}
						}
					}
				}
			}
		}
	}
}
